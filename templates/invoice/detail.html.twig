{% extends '@!EasyAdmin/page/content.html.twig' %}

{% block main %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <h4 class="page-title">{% trans %}procurement.invoice{% endtrans %}</h4>
                    <div class="page-title-right">
                        <a class="action-index btn btn-secondary" href="/admin?crudAction=index&crudControllerFqcn=Prolyfix%5CProcurementBundle%5CController%5CInvoiceCrudController" data-action-name="index">
                            <span class="action-label">{% trans %}back{% endtrans %}</span>
                        </a>
                        <a class="action-edit btn btn-primary" href="/admin?crudAction=edit&crudControllerFqcn=Prolyfix%5CProcurementBundle%5CController%5CInvoiceCrudController&entityId={{ entity.instance.id }}" data-action-name="edit">
                            <span class="action-label">{% trans %}edit{% endtrans %}</span>
                        </a>
                        <a class="action-download-pdf btn btn-outline-primary" href="{{ ea_url().setController('Prolyfix\\ProcurementBundle\\Controller\\InvoiceCrudController').setAction('downloadPdf').setEntityId(entity.instance.id).generateUrl() }}" data-action-name="downloadPdf">
                            <span class="action-label">{% trans %}procurement.downloadPdf{% endtrans %}</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-4">
                {% include '@ProlyfixProcurement/invoice/_summary.html.twig' %}
            </div>
            <div class="col-lg-{% if entity.instance.sourceDocument %}4{% else %}8{% endif %}">
                {% include '@ProlyfixProcurement/invoice/_orders_table.html.twig' %}
            </div>
            {% if entity.instance.sourceDocument %}
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{% trans %}procurement.ocr.document{% endtrans %}</h5>
                    </div>
                    <div class="card-body p-0">
                        <iframe src="{{ path('procurement_ocr_serve_pdf', {id: entity.instance.sourceDocument.id}) }}"
                                style="width:100%; height:500px; border:none;"
                                title="Invoice document">
                        </iframe>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <div class="row mt-3">
            <div class="col-12">
                {% include '@ProlyfixProcurement/invoice/_lines_table.html.twig' %}
            </div>
        </div>

        <div class="row">
            <div class="col-lg-4">
                {% include '@ProlyfixProcurement/_includes/_related_documents.html.twig' with {
                    title: 'Related Documents',
                    orders: entity.instance.orders,
                    deliverySlips: entity.instance.deliverySlips
                } %}
            </div>
        </div>
    </div>
{% endblock %}
