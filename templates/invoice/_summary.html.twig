<div class="card">
    <div class="card-body">
        <h4 class="card-title font-16 mb-3">{% trans %}procurement.invoice{% endtrans %}</h4>

        <div class="mb-3">
            <h5 class="mt-0">ID</h5>
            <p>{{ entity.instance.id }}</p>
        </div>

        <div class="mb-3">
            <h5 class="mt-0">{% trans %}State{% endtrans %}</h5>
            <p>{{ entity.instance.isPaid ? 'Paid' : 'Open' }}</p>
        </div>

        <div class="mb-0">
            <h5 class="mt-0">{% trans %}procurement.order{% endtrans %}</h5>
            <p>{{ entity.instance.orders|length }}</p>
        </div>

        {% if entity.instance.totalAmount is not null %}
        <div class="mb-0">
            <h5 class="mt-0">{% trans %}procurement.totalPrice{% endtrans %}</h5>
            <p class="fw-bold">{{ entity.instance.totalAmount|number_format(2, '.', ' ') }} €</p>
        </div>
        {% endif %}
    </div>
</div>
