{% extends '@!EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    {{ product.name }} - Inventar Detail
{% endblock %}

{% block main %}
    <div class="mb-3 d-flex gap-2" {{ stimulus_controller('modal-form') }}>
        <a href="{{ ea_url().setController('Prolyfix\\ProcurementBundle\\Controller\\InventarCrudController').setAction('show').generateUrl() }}" class="btn btn-outline-secondary">
            {% trans %}Back to inventar{% endtrans %}
        </a>
        <button type="button" class="btn btn-primary" data-action="modal-form#openModal" data-url="{{ ea_url().setController('Prolyfix\\ProcurementBundle\\Controller\\InventarCrudController').setAction('add').set('productId', product.id).generateUrl() }}">
            {% trans %}Add movement{% endtrans %}
        </button>
        <button type="button" class="btn btn-info" data-action="modal-form#openModal" data-url="{{ ea_url().setController('Prolyfix\\ProcurementBundle\\Controller\\InventarCrudController').setAction('add').set('productId', product.id).set('isInventar', 1).generateUrl() }}">
            Inventar
        </button>
    </div>

    {% if alertMessage %}
        <div class="alert alert-danger" role="alert">{{ alertMessage }}</div>
    {% endif %}

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">{% trans %}Current stock{% endtrans %}: {{ currentStock }}</h5>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{% trans %}Date{% endtrans %}</th>
                    <th>{% trans %}Quantity added{% endtrans %}</th>
                    <th>{% trans %}Quantity removed{% endtrans %}</th>
                    <th>Date de péremption</th>
                </tr>
            </thead>
            <tbody>
                {% for movement in movements %}
                    {% set quantity = movement.quantity ?? 0 %}
                    <tr class="{% if movement.isInventar %}fw-bold{% endif %}">
                        <td>{{ movement.creationDate ? movement.creationDate|date('d.m.Y') : '' }}</td>
                        <td>{{ quantity > 0 ? quantity : '' }}</td>
                        <td>{{ quantity < 0 ? quantity|abs : '' }}</td>
                        <td>{{ movement.expirationDate ? movement.expirationDate|date('d.m.Y') : '' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">{% trans %}No movement{% endtrans %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
